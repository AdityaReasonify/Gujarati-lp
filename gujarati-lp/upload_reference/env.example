# Template for learning_plan_upload/.env — copy to that tool's root as `.env`.
# No secrets here. `config.json` (the GCP service-account key) is NOT in this zip
# and must be supplied on the new machine.

# Staging. The client appends /api/... itself (see src/lp_sync/api_client.py).
PYTHON_BASE_URL=https://staging.singularity-learn.com/agentapi

BUCKET_NAME=learning_plan_assets

# RegId recorded as the creator of imported plan versions (lp2_plans.created_by).
# Left blank: the class-10 Hindi plans reuse existing remote image URLs and upload
# no assets, so nothing is attributed to a user account by this run.
CREATED_BY=

LOG_LEVEL=INFO

# fetch-chapters DB source — not needed here; chapter_master_map.json already
# carries all 14 class-10 Hindi chapters.
EDUCATIONDB_URL=

# CREATED_BY (gujarati-lp): SET IT before any GSEB Gujarati upload. The comment above is the
# previous pack's situation, not this one — the Hindi run left CREATED_BY blank and the
# authorship of every uploaded plan version was lost with no way to recover it after the fact.
# Use the authoring account's RegId. EDUCATIONDB_URL is likewise required here: no GSEB rows
# exist yet, so chapter_master_map.json ships with every chapter_master_id null (VERIFY-2).
